# 服务端口
PORT=3000

# 认证密钥：生产环境请使用 32 字节以上的随机值。
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-strong-random-secret-before-production

# 认证令牌有效期（秒）
AUTH_TOKEN_TTL_SECONDS=604800

# 环境
NODE_ENV=development

# ===== 音频转写（v1.1）=====
# 可选值：openai（OpenAI 兼容 /audio/transcriptions）、command（本地 whisper 命令行）
# 留空则关闭离线转写，接口返回明确的未配置提示（不会伪造转写结果）
ASR_PROVIDER=
# openai 模式：任意兼容 OpenAI 音频转写协议的服务（OpenAI、硅基流动、本地 faster-whisper-server）
ASR_API_URL=https://api.openai.com/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL=whisper-1
# command 模式：模板必须包含 {input} 与 {output}，可选 {language} {model} {format}
# 例：ASR_COMMAND=whisper-cli -m models/ggml-small.bin -l {language} -f {input} -otxt -of {output}
ASR_COMMAND=
ASR_LANGUAGE=zh
ASR_TIMEOUT_MS=900000
ASR_MAX_ATTEMPTS=3
ASR_RETRY_DELAY_MS=30000
ASR_POLL_INTERVAL_MS=1000

# ===== LLM 智能增强（v1.2）=====
# 任意 OpenAI 兼容 chat/completions 服务：智谱 GLM、通义 compatible-mode、DeepSeek、vLLM、Ollama
# 不配置也能启动：相关功能自动使用规则模板，并在响应中标记 engine/degraded
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 仅当服务支持 response_format={"type":"json_object"} 时设为 on
LLM_JSON_MODE=off
# 成本估算（元/千 tokens），用于 llm_calls 审计
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

